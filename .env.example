# ===================================================================
# InteriorAI - Production Environment Variables Template
# ===================================================================
# DO NOT commit your actual .env file with production passwords.
# Configure these variables in your Vercel Project Settings > Environment Variables.
# ===================================================================

# -------------------------------------------------------------------
# 1. Server Configuration
# -------------------------------------------------------------------
# Injected dynamically by Vercel / Cloud Container runtime
PORT=8080

# -------------------------------------------------------------------
# 2. Production External MySQL Database (MANDATORY FOR PRODUCTION)
# -------------------------------------------------------------------
# Connect to an external managed MySQL 8.0+ service
# Examples: Aiven MySQL, AWS RDS, PlanetScale, Clever Cloud, DigitalOcean Managed MySQL
#
# Option A: Full JDBC Connection String (Recommended for Cloud Providers with SSL)
DB_URL=jdbc:mysql://your-cloud-mysql-host.example.com:3306/interiorai_db?useSSL=true&requireSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Database Credentials
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password

# -------------------------------------------------------------------
# 3. Security & JWT Configuration
# -------------------------------------------------------------------
# Secret key used for signing and verifying stateless HS384/HS512 JWT tokens.
# Generate a secure 64-character hex or base64 string for production.
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# -------------------------------------------------------------------
# 4. AI Design Generation Integration
# -------------------------------------------------------------------
# When AI_DEMO_MODE=true or AI_API_KEY is blank, InteriorAI uses high-resolution
# realistic demonstration transformations with zero external cost.
# To enable live DALL-E 3 / OpenAI image generations, set your API key:
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/images/generations
AI_DEMO_MODE=true
AI_MODEL=dall-e-3

# -------------------------------------------------------------------
# 5. Cross-Origin Resource Sharing (CORS) Configuration
# -------------------------------------------------------------------
# Comma-separated list of origins allowed to make requests to the backend.
# Automatically includes https://*.vercel.app for Vercel preview & production deployments.
CORS_ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:3000,http://localhost:8080

# -------------------------------------------------------------------
# 6. Frontend Environment Configuration (For Frontend Vercel Project)
# -------------------------------------------------------------------
# Point your deployed frontend to your deployed backend URL.
INTERIORAI_API_URL=https://interiorai-backend.vercel.app
